# ==============================================================================
# POOL DE CHAVES DO GEMINI (GOOGLE AI STUDIO) - GEMINI 4 ARGON
# ==============================================================================
# Insira as chaves de API das suas contas do Google AI Studio abaixo:
# Você pode preencher até 5 contas (ou mais) para balanceamento e anti-429.

GEMINI_KEY_1="cole_a_chave_da_conta_1_aqui"
GEMINI_KEY_2="cole_a_chave_da_conta_2_aqui"
GEMINI_KEY_3="cole_a_chave_da_conta_3_aqui"
GEMINI_KEY_4="cole_a_chave_da_conta_4_aqui"
GEMINI_KEY_5="cole_a_chave_da_conta_5_aqui"

# Ou alternativamente como uma lista única separada por vírgula:
# GEMINI_API_KEYS="chave1,chave2,chave3,chave4,chave5"

# Chave única legado (caso use apenas uma):
GEMINI_API_KEY=""

# Modelo padrão a ser utilizado
GEMINI_MODEL="gemini-4-argon"

# URLs do app
APP_URL="http://localhost:3000"
VITE_API_URL="http://localhost:3001/api"
